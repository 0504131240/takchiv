rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules → Publish,
// with __OWNER_EMAILS__ replaced by the owner's Google email in quotes, e.g. 'a@gmail.com' (kept out of this public repo).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email.lower(); }
    function isMember(pid) {
      return signedIn() && me() in get(/databases/$(database)/documents/profiles/$(pid)).data.emails;
    }

    // A profile is visible/editable only by the emails listed on it
    match /profiles/{pid} {
      allow read: if signedIn() && me() in resource.data.emails;
      allow create: if signedIn() && request.resource.data.emails == [me()];
      allow update: if signedIn() && me() in resource.data.emails
                    && request.resource.data.emails.size() > 0;
      allow delete: if false;

      match /data/{docId} {
        allow read, write: if isMember(pid);
      }
    }

    // Sign-in counts for the owner's dashboard: each user writes only their own entry, only the owner reads them
    match /logins/{em} {
      allow read: if signedIn() && me() in [__OWNER_EMAILS__];
      allow create, update: if signedIn() && em == me()
                            && request.resource.data.keys().hasOnly(['email', 'name', 'lastSeen', 'count'])
                            && request.resource.data.email == me();
      allow delete: if false;
    }

    // Old data from before login: closed now that every profile has been moved
    match /budget/{docId} {
      allow read, write: if false;
    }
  }
}
